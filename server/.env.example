# ============ 服务配置 ============
PORT=3000
# 允许跨域的来源，*,* 表示放开（小程序请求没有 Origin，不校验）
CORS_ORIGIN=*

# ============ 限流 ============
# 单个 IP 每分钟最多请求次数
RATE_LIMIT_PER_MIN=30

# ============ 网络 ============
# 单次上游请求超时（毫秒）
HTTP_TIMEOUT=15000
# 短链最多跟随几跳
MAX_REDIRECTS=6
# 需要走代理时填，例如 http://user:pass@host:port（服务器在海外、平台限定国内 IP 时用得上）
PROXY_URL=

# ============ 解析通道 ============
# 上游解析服务（可选）。填上之后会优先走它，失败再回落到本地解析器。
# 约定：向该地址 POST {"url": "..."} ，返回 {"code":0,"data":{...}}
UPSTREAM_URL=
UPSTREAM_TOKEN=
# 上游超时（毫秒）
UPSTREAM_TIMEOUT=12000

# 抖音签名服务（可选）。抖音 Web 接口需要 a_bogus 签名，
# 填上你自己的签名服务地址后，抖音解析走官方 Web 接口，成功率更高。
# 约定：POST {"url": "完整请求地址"} → {"a_bogus": "..."}
DOUYIN_SIGNER_URL=

# ============ 日志 ============
LOG_LEVEL=info
