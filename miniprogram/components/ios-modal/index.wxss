.md-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.24);
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
}

.md-box {
  width: 560rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: rgba(252, 252, 253, 0.94);
  -webkit-backdrop-filter: saturate(180%) blur(40rpx);
  backdrop-filter: saturate(180%) blur(40rpx);
  box-shadow: 0 30rpx 90rpx rgba(0, 0, 0, 0.24);
}

.md-body {
  padding: 44rpx 40rpx 36rpx;
  text-align: center;
}

.md-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--label);
  line-height: 1.35;
}

.md-content {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: var(--label-2);
}

.md-actions {
  display: flex;
  border-top: 1rpx solid var(--sep);
  position: relative;
}

.md-actions::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: var(--sep);
  transform: scaleY(0.5);
}

.md-btn {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 33rpx;
  color: var(--ios-blue);
  position: relative;
  transition: background 0.16s cubic-bezier(0.32, 0.72, 0, 1);
}

.md-cancel {
  font-weight: 400;
}

.md-confirm {
  font-weight: 600;
  border-left: 1rpx solid var(--sep);
}

.md-btn-hover {
  background: var(--fill);
}

.md-destructive {
  color: var(--ios-red);
}
