/* ============================================================
   全局设计系统 —— iOS 设计语言
   所有颜色 / 圆角 / 阴影 / 缓动统一走变量，页面里不写死色值
   ============================================================ */

page {
  /* 主色 */
  --ios-blue: #0A84FF;
  --ios-blue-deep: #0060DF;
  --ios-green: #34C759;
  --ios-orange: #FF9500;
  --ios-red: #FF3B30;

  /* 背景层 */
  --bg: #F2F2F7;
  --bg-top: #EAF3FF;
  --bg-bottom: #F2F2F7;

  /* 卡片 / 材质 */
  --card: #FFFFFF;
  --card-glass: rgba(255, 255, 255, 0.72);
  --card-glass-strong: rgba(255, 255, 255, 0.86);
  --nav-glass: rgba(249, 249, 251, 0.78);

  /* 文字 */
  --label: #000000;
  --label-2: rgba(60, 60, 67, 0.60);
  --label-3: rgba(60, 60, 67, 0.32);
  --label-inv: #FFFFFF;

  /* 分隔 / 填充 */
  --sep: rgba(60, 60, 67, 0.10);
  --sep-strong: rgba(60, 60, 67, 0.18);
  --fill: rgba(120, 120, 128, 0.10);
  --fill-2: rgba(120, 120, 128, 0.16);

  /* 圆角（iOS 连续圆角观感 —— 用足够大的半径模拟） */
  --r-xs: 12rpx;
  --r-sm: 20rpx;
  --r-md: 28rpx;
  --r-lg: 36rpx;
  --r-xl: 44rpx;

  /* 阴影 */
  --sh-1: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --sh-2: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  --sh-3: 0 20rpx 60rpx rgba(10, 60, 140, 0.10);
  --sh-blue: 0 16rpx 40rpx rgba(10, 132, 255, 0.28);

  /* 动效 */
  --ease-ios: cubic-bezier(0.32, 0.72, 0, 1);
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);

  /* 安全区 */
  --safe-bottom: env(safe-area-inset-bottom);

  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display",
    "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;

  color: var(--label);
  font-size: 30rpx;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
  background: var(--bg);
}

view, text, textarea, input, button, scroll-view, image, navigator {
  box-sizing: border-box;
}

/* 页面底色：顶部一层极淡的蓝灰渐晕，营造 iOS 的柔和空间感 */
.page-bg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  background:
    radial-gradient(120% 60% at 50% 0%, #E4EEFF 0%, rgba(242, 242, 247, 0) 62%),
    linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 42%);
}

/* ---------- 毛玻璃材质 ---------- */
.glass {
  background: var(--card-glass);
  -webkit-backdrop-filter: saturate(180%) blur(40rpx);
  backdrop-filter: saturate(180%) blur(40rpx);
}

.glass-nav {
  background: var(--nav-glass);
  -webkit-backdrop-filter: saturate(180%) blur(44rpx);
  backdrop-filter: saturate(180%) blur(44rpx);
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-2);
}

.card-flat {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
}

/* iOS 分组列表（设置页那种一块一块的） */
.group {
  background: var(--card);
  border-radius: var(--r-md);
  overflow: hidden;
  box-shadow: var(--sh-1);
}

.group-title {
  font-size: 26rpx;
  color: var(--label-2);
  padding: 0 32rpx 14rpx;
  letter-spacing: 0.4rpx;
}

.cell {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 24rpx 32rpx;
  position: relative;
  transition: background 0.18s var(--ease-ios);
}

.cell:active {
  background: var(--fill);
}

.cell + .cell::before {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: var(--sep);
  transform: scaleY(0.5);
}

.cell-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--label);
}

.cell-value {
  font-size: 28rpx;
  color: var(--label-3);
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--label-3);
  border-bottom: 3rpx solid var(--label-3);
  transform: rotate(-45deg);
  margin-left: 14rpx;
  flex-shrink: 0;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: var(--r-md);
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: 0.6rpx;
  transition: transform 0.18s var(--ease-ios), opacity 0.18s var(--ease-ios);
}

.btn-primary {
  background: linear-gradient(180deg, #2E96FF 0%, var(--ios-blue-deep) 100%);
  color: var(--label-inv);
  box-shadow: var(--sh-blue);
}

.btn-ghost {
  background: var(--fill);
  color: var(--ios-blue);
}

.btn-danger {
  background: rgba(255, 59, 48, 0.10);
  color: var(--ios-red);
}

.btn:active {
  transform: scale(0.972);
  opacity: 0.92;
}

.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
  box-shadow: none;
}

/* ---------- 输入区域 ---------- */
.field {
  background: var(--card);
  border-radius: var(--r-md);
  padding: 28rpx;
  box-shadow: var(--sh-1);
  transition: box-shadow 0.24s var(--ease-ios), transform 0.24s var(--ease-ios);
}

.field-focus {
  box-shadow: 0 0 0 6rpx rgba(10, 132, 255, 0.14), var(--sh-1);
}

.field-input {
  width: 100%;
  min-height: 150rpx;
  font-size: 29rpx;
  line-height: 1.5;
  color: var(--label);
}

.field-placeholder {
  color: var(--label-3);
  font-size: 29rpx;
}

/* ---------- 底部安全区 ---------- */
.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- 主题级动效 ---------- */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes popIn {
  0%   { opacity: 0; transform: scale(0.9); }
  100% { opacity: 1; transform: scale(1); }
}

.anim-fade-up {
  animation: fadeUp 0.42s var(--ease-out) both;
}

.anim-pop {
  animation: popIn 0.34s var(--ease-out) both;
}

/* 隐藏滚动条（iOS 观感） */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}
