.wrap {
  padding: 0 32rpx;
  min-height: 100vh;
}

/* ---------- 媒体舞台 ---------- */
.stage {
  margin-top: 8rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
  background: #0B0B0F;
  box-shadow: var(--sh-3);
  position: relative;
}

.video {
  width: 100%;
  height: 840rpx;
  background: #000;
}

.swiper {
  width: 100%;
  height: 840rpx;
  background: #0B0B0F;
}

.media-img {
  width: 100%;
  height: 100%;
}

.stage-counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.42);
  -webkit-backdrop-filter: blur(16rpx);
  backdrop-filter: blur(16rpx);
  color: #fff;
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

.stage-fallback {
  height: 840rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 26rpx;
}

.fb-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.22);
  border-top-color: rgba(255, 255, 255, 0.7);
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------- 信息卡 ---------- */
.info {
  margin-top: 32rpx;
  padding: 32rpx 30rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-2);
}

.info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.tag-platform {
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.tag-type {
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--label-2);
  font-size: 23rpx;
}

.info-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.38;
  color: var(--label);
  letter-spacing: -0.2rpx;
}

.info-author {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--label-3);
}

/* ---------- 分组标题 ---------- */
.section-title {
  padding: 48rpx 8rpx 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--label);
}

/* ---------- 操作行 ---------- */
.cell-hover {
  background: var(--fill);
}

.cell-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  position: relative;
}

.icon-save   { background: rgba(10, 132, 255, 0.14); }
.icon-link   { background: rgba(52, 199, 89, 0.14); }
.icon-text   { background: rgba(255, 149, 0, 0.14); }
.icon-source { background: rgba(120, 120, 128, 0.16); }

.icon-save::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 14rpx;
  width: 4rpx;
  height: 18rpx;
  margin-left: -2rpx;
  background: var(--ios-blue);
  border-radius: 2rpx;
  box-shadow: 0 20rpx 0 -2rpx var(--ios-blue);
}

.icon-link::after {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 20rpx;
  width: 20rpx;
  height: 12rpx;
  border: 3rpx solid var(--ios-green);
  border-radius: 999rpx;
  transform: rotate(-45deg);
}

.icon-text::after {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 18rpx;
  width: 24rpx;
  height: 4rpx;
  background: var(--ios-orange);
  border-radius: 2rpx;
  box-shadow: 0 10rpx 0 var(--ios-orange), 0 20rpx 0 var(--ios-orange);
}

.icon-source::after {
  content: '';
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #8E8E93;
  border-radius: 6rpx;
}

/* ---------- 图片网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-item {
  width: calc((100% - 32rpx) / 3);
  height: 220rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
  position: relative;
  background: var(--fill-2);
}

.grid-img {
  width: 100%;
  height: 100%;
}

.grid-save {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.42);
  -webkit-backdrop-filter: blur(14rpx);
  backdrop-filter: blur(14rpx);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 底部说明 / 空态 ---------- */
.foot-note {
  margin: 48rpx 8rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: var(--label-3);
  line-height: 1.6;
}

.empty {
  padding: 240rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--label-3);
}
