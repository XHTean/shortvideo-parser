.wrap {
  padding: 0 32rpx;
  min-height: 100vh;
}

/* ---------- Hero ---------- */
.hero {
  padding: 12rpx 8rpx 44rpx;
}

.hero-eyebrow {
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 3.2rpx;
  color: var(--ios-blue);
  opacity: 0.7;
  margin-bottom: 14rpx;
}

.hero-title {
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: -1.4rpx;
  line-height: 1.12;
  color: var(--label);
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--label-2);
  letter-spacing: 0.2rpx;
}

/* ---------- 输入卡片 ---------- */
.field {
  padding: 32rpx 30rpx 22rpx;
}

.field-input {
  width: 100%;
  min-height: 168rpx;
  font-size: 29rpx;
  line-height: 1.5;
  color: var(--label);
}

.field-mirror {
  word-break: break-all;
  color: var(--label);
}

.field-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--sep);
}

.chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(10, 132, 255, 0.10);
  color: var(--ios-blue);
  font-size: 25rpx;
  font-weight: 500;
  transition: transform 0.18s cubic-bezier(0.32, 0.72, 0, 1);
}

.chip-hover {
  transform: scale(0.95);
  opacity: 0.85;
}

.chip-quiet {
  background: var(--fill);
  color: var(--label-2);
}

.chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ios-blue);
  box-shadow: 0 0 0 6rpx rgba(10, 132, 255, 0.16);
}

.field-count {
  margin-left: auto;
  font-size: 23rpx;
  color: var(--label-3);
  font-variant-numeric: tabular-nums;
}

/* ---------- 主按钮 ---------- */
.main-btn {
  margin-top: 32rpx;
}

.hint-line {
  margin-top: 20rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--label-3);
}

/* ---------- Section ---------- */
.section {
  margin-top: 56rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--label);
  letter-spacing: 0.2rpx;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--ios-blue);
}

.more-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid var(--ios-blue);
  border-bottom: 3rpx solid var(--ios-blue);
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

/* ---------- 平台标签 ---------- */
.plat-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.plat {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 66rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--card-glass-strong);
  -webkit-backdrop-filter: saturate(180%) blur(24rpx);
  backdrop-filter: saturate(180%) blur(24rpx);
  box-shadow: var(--sh-1);
  font-size: 26rpx;
  color: var(--label-2);
}

.plat-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  opacity: 0.85;
}

/* ---------- 最近解析 ---------- */
.cell-hover {
  background: var(--fill);
}

.recent-cell {
  padding: 22rpx 30rpx;
}

.thumb {
  width: 108rpx;
  height: 108rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: var(--fill-2);
  flex-shrink: 0;
  position: relative;
  margin-right: 24rpx;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-empty {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #E7ECF5 0%, #D9E3F3 100%);
}

.thumb-play {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 0;
  height: 0;
  border-left: 18rpx solid rgba(255, 255, 255, 0.94);
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
  filter: drop-shadow(0 1rpx 3rpx rgba(0, 0, 0, 0.35));
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-title {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--label);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recent-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 23rpx;
  color: var(--label-3);
}

.meta-badge {
  font-weight: 600;
}

.meta-dot {
  opacity: 0.6;
}
