.wrap {
  padding: 0 32rpx;
  min-height: 100vh;
}

.head {
  padding: 12rpx 8rpx 36rpx;
}

.head-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: var(--label);
}

.head-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--label-2);
}

/* ---------- 左滑列表 ---------- */
.swipe-list {
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--card);
  box-shadow: var(--sh-1);
}

.swipe-area {
  width: 100%;
  height: 212rpx;
  position: relative;
  background: var(--card);
  overflow: hidden;
}

.swipe-area + .swipe-area::before {
  content: '';
  position: absolute;
  left: 30rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: var(--sep);
  transform: scaleY(0.5);
  z-index: 3;
}

.swipe-view {
  width: calc(100% + 176rpx);
  height: 212rpx;
  display: flex;
  align-items: center;
  background: var(--card);
  position: relative;
  z-index: 2;
}

.row {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: var(--card);
  transition: background 0.16s cubic-bezier(0.32, 0.72, 0, 1);
}

.row-hover {
  background: #FAFAFC;
}

.swipe-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ios-red);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  z-index: 1;
}

/* ---------- 行内容 ---------- */
.thumb {
  width: 132rpx;
  height: 132rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--fill-2);
  flex-shrink: 0;
  position: relative;
  margin-right: 26rpx;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-empty {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #E7ECF5 0%, #D9E3F3 100%);
}

.thumb-play {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 0;
  height: 0;
  border-left: 20rpx solid rgba(255, 255, 255, 0.94);
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  filter: drop-shadow(0 1rpx 3rpx rgba(0, 0, 0, 0.35));
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--label);
  line-height: 1.34;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.row-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 23rpx;
  color: var(--label-3);
}

.meta-badge {
  font-weight: 600;
}

.meta-dot {
  opacity: 0.6;
}

/* ---------- 底部 ---------- */
.clear-btn {
  margin-top: 44rpx;
}

.foot-note {
  margin-top: 24rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--label-3);
}

/* ---------- 空态 ---------- */
.empty {
  padding: 140rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-art {
  width: 300rpx;
  height: 220rpx;
  position: relative;
  margin-bottom: 48rpx;
}

.empty-card {
  position: absolute;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 36rpx rgba(20, 40, 80, 0.10);
}

.c1 {
  width: 190rpx;
  height: 130rpx;
  left: 0;
  top: 50rpx;
  transform: rotate(-8deg);
  opacity: 0.7;
}

.c2 {
  width: 190rpx;
  height: 130rpx;
  right: 0;
  top: 30rpx;
  transform: rotate(7deg);
  opacity: 0.85;
}

.c3 {
  width: 200rpx;
  height: 140rpx;
  left: 50rpx;
  top: 62rpx;
  background: linear-gradient(160deg, #FFFFFF 0%, #EAF2FF 100%);
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--label);
}

.empty-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--label-3);
}

.empty-btn {
  margin-top: 44rpx;
  width: 340rpx;
}
